{
  "name": "catch-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1431 --strictPort",
    "build": "node ../tools/frontend-licenses.cjs && vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "format": "prettier --write src test vite.config.ts tsconfig.json",
    "format:check": "prettier --check src test vite.config.ts tsconfig.json",
    "preview": "vite preview --host 127.0.0.1 --port 4319 --strictPort"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
