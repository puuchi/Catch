{
  "name": "catch-desktop",
  "productName": "Catch",
  "version": "2.0.0",
  "private": true,
  "description": "Catch：本地悬浮待办、活动计时与时间轴",
  "main": "src/bootstrap/main.js",
  "scripts": {
    "start": "node tools/build.js && electron .",
    "build": "node tools/build.js",
    "test": "node --test test/*.test.js",
    "check": "tsc -p jsconfig.json && node tools/check-architecture.js",
    "test:electron": "node tools/build.js && node test/electron.cjs",
    "pack": "node tools/build.js && electron-builder --win --x64 --dir --publish never",
    "dist": "node tools/build.js && electron-builder --win --x64 --publish never && node tools/checksums.cjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "author": "puuchi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/puuchi/Catch.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "io.github.puuchi.catch",
    "productName": "Catch",
    "artifactName": "Catch-${version}-${arch}-${os}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!src/ui/main.js",
      "!src/ui/todos/**",
      "!src/ui/tracking/*.js",
      "!src/ui/trash/**",
      "!src/ui/shared/*.js",
      "!src/ui/sprout/*.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
